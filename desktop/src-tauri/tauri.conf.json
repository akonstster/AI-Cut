{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-Cut",
  "version": "2.2.0",
  "identifier": "com.aicut.studio",
  "build": {
    "frontendDist": "../../frontend/dist",
    "beforeBundleCommand": "echo The installer is built only with npm run bundle, which adds the staged window of src-tauri/tauri.bundle.conf.json && exit 1"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "linux": { "appimage": { "bundleMediaFramework": true } },
    "active": false,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "installer-hooks.nsi",
        "languages": ["English", "Russian"],
        "customLanguageFiles": {
          "English": "installer-english.nsh",
          "Russian": "installer-russian.nsh"
        }
      }
    }
  },
  "mainBinaryName": "AICut"
}
